{
  "expo": {
    "name": "SPARK LIST",
    "slug": "sparklist",
    "scheme": "sparklist",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.mimichild.sparklist",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#F0ADB4"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "SPARK LIST 需要存取你的相簿，讓你可以為單品新增照片。",
          "cameraPermission": "SPARK LIST 需要使用相機，讓你可以直接拍攝單品照片。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b5d0f0f-7421-4509-a1bd-d80dd52c01cd"
      }
    },
    "owner": "mimichild"
  }
}
